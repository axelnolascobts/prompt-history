{
  "openapi": "3.0.0",
  "info": {
    "title": "Student Management API",
    "version": "1.0.0",
    "description": "A RESTful API to manage students and their courses"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/students": {
      "get": {
        "summary": "Retrieve students (filter by id, name, email, or course using query params)",
        "tags": ["Students"],
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "name", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "email", "in": "query", "schema": { "type": "string", "format": "email" }, "required": false },
          { "name": "course", "in": "query", "schema": { "type": "string" }, "required": false }
        ],
        "responses": {
          "200": {
            "description": "Students retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StudentsResponse" },
                "example": {
                  "status": 200,
                  "message": "Students retrieved successfully",
                  "data": [
                    { "id": "1", "name": "Milton", "email": "milton@gmail.com", "courses": ["Math"] }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No students found with the given query",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "status": 404,
                  "message": "No students found with the given query",
                  "data": []
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new student",
        "tags": ["Students"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewStudent" },
              "example": {
                "name": "Jane Doe",
                "email": "jane@example.com",
                "courses": ["Math", "Science"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StudentResponse" },
                "example": {
                  "status": 201,
                  "message": "Student created successfully",
                  "data": {
                    "id": "2",
                    "name": "Jane Doe",
                    "email": "jane@example.com",
                    "courses": ["Math", "Science"]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or email already exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "emptyBody": {
                    "summary": "Empty body",
                    "value": { "status": 400, "message": "Request body cannot be empty", "data": null }
                  },
                  "invalidInput": {
                    "summary": "Invalid input",
                    "value": { "status": 400, "message": "Invalid input", "data": [] }
                  },
                  "duplicateEmail": {
                    "summary": "Duplicate email",
                    "value": { "status": 400, "message": "The email already exists", "data": null }
                  },
                  "invalidEmailFormat": {
                    "summary": "Invalid email format",
                    "value": { "status": 400, "message": "Invalid email format", "data": null }
                  },
                  "invalidName": {
                    "summary": "Invalid name",
                    "value": { "status": 400, "message": "Name contains invalid characters", "data": null }
                  },
                  "emptyName": {
                    "summary": "Empty name",
                    "value": { "status": 400, "message": "Name cannot be empty", "data": null }
                  },
                  "invalidCourses": {
                    "summary": "Invalid courses",
                    "value": { "status": 400, "message": "Courses must be a non-empty array", "data": null }
                  },
                  "duplicateCourses": {
                    "summary": "Duplicate courses",
                    "value": { "status": 400, "message": "Courses must not contain duplicates", "data": null }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Fully update a student by id or email (query param)",
        "tags": ["Students"],
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "email", "in": "query", "schema": { "type": "string", "format": "email" }, "required": false }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewStudent" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Student edited successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StudentResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing query param",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "missingParam": {
                    "summary": "Missing query param",
                    "value": { "status": 400, "message": "Query param 'id' or 'email' is required", "data": null }
                  },
                  "invalidInput": {
                    "summary": "Invalid input",
                    "value": { "status": 400, "message": "Invalid input", "data": [] }
                  },
                  "duplicateEmail": {
                    "summary": "Duplicate email",
                    "value": { "status": 400, "message": "The email already exists", "data": null }
                  },
                  "duplicateCourses": {
                    "summary": "Duplicate courses",
                    "value": { "status": 400, "message": "Courses must not contain duplicates", "data": null }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "status": 404, "message": "Student not found", "data": null }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Partially update a student by id or email (query param)",
        "tags": ["Students"],
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "email", "in": "query", "schema": { "type": "string", "format": "email" }, "required": false }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PartialStudent" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Student updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StudentResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing query param",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "missingParam": {
                    "summary": "Missing query param",
                    "value": { "status": 400, "message": "Query param 'id' or 'email' is required", "data": null }
                  },
                  "invalidInput": {
                    "summary": "Invalid input",
                    "value": { "status": 400, "message": "Invalid input", "data": [] }
                  },
                  "duplicateEmail": {
                    "summary": "Duplicate email",
                    "value": { "status": 400, "message": "This email is already registered", "data": null }
                  },
                  "duplicateCourses": {
                    "summary": "Duplicate courses",
                    "value": { "status": 400, "message": "Courses must not contain duplicates", "data": null }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "status": 404, "message": "Student not found", "data": null }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a student by id or email (query param)",
        "tags": ["Students"],
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "email", "in": "query", "schema": { "type": "string", "format": "email" }, "required": false }
        ],
        "responses": {
          "200": {
            "description": "Student deleted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StudentResponse" }
              }
            }
          },
          "400": {
            "description": "Missing query param",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "status": 400, "message": "Query param 'id' or 'email' is required", "data": null }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "status": 404, "message": "Student not found", "data": null }
              }
            }
          }
        }
      }
    },
    "/students/by-course": {
      "get": {
        "summary": "Get students by course (query param)",
        "tags": ["Students"],
        "parameters": [
          { "name": "course", "in": "query", "schema": { "type": "string" }, "required": true }
        ],
        "responses": {
          "200": {
            "description": "Students retrieved for course",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StudentsResponse" }
              }
            }
          },
          "400": {
            "description": "Missing course query param",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "status": 400, "message": "Course query param is required", "data": null }
              }
            }
          }
        }
      }
    },
    "/courses": {
      "post": {
        "summary": "Create a new course (just validates name, does not persist)",
        "tags": ["Courses"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "course": { "type": "string" } }, "required": ["course"] },
              "example": { "course": "Math" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CourseCreateResponse" },
                "example": {
                  "status": 201,
                  "message": "Course created (add to students via student endpoints)",
                  "data": { "course": "Math" }
                }
              }
            }
          },
          "400": {
            "description": "Course name is required or invalid",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "empty": {
                    "summary": "Empty course name",
                    "value": { "status": 400, "message": "Course name is required", "data": null }
                  },
                  "invalid": {
                    "summary": "Invalid course name",
                    "value": { "status": 400, "message": "Course name is required", "data": null }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get students enrolled in a course (query param)",
        "tags": ["Courses"],
        "parameters": [
          { "name": "course", "in": "query", "schema": { "type": "string" }, "required": true }
        ],
        "responses": {
          "200": {
            "description": "Students retrieved for course",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StudentsResponse" },
                "example": {
                  "status": 200,
                  "message": "Students retrieved for course",
                  "data": [
                    { "id": "1", "name": "Milton", "email": "milton@gmail.com", "courses": ["Math"] }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid course query param",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "missing": {
                    "summary": "Missing course param",
                    "value": { "status": 400, "message": "Course query param is required", "data": null }
                  },
                  "invalid": {
                    "summary": "Invalid course param",
                    "value": { "status": 400, "message": "Course query param is required", "data": null }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a course from all students (query param)",
        "tags": ["Courses"],
        "parameters": [
          { "name": "course", "in": "query", "schema": { "type": "string" }, "required": true }
        ],
        "responses": {
          "200": {
            "description": "Course deleted from all students",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CourseDeleteResponse" },
                "example": {
                  "status": 200,
                  "message": "Course deleted from all students",
                  "data": "Math"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid course query param",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "missing": {
                    "summary": "Missing course param",
                    "value": { "status": 400, "message": "Course query param is required", "data": null }
                  },
                  "invalid": {
                    "summary": "Invalid course param",
                    "value": { "status": 400, "message": "Course query param is required", "data": null }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Course not found in any student",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "notFound": {
                    "summary": "Course not found",
                    "value": { "status": 404, "message": "Course not found", "data": null }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Student": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "courses": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "NewStudent": {
        "type": "object",
        "required": ["name", "email", "courses"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "courses": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "PartialStudent": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "courses": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "StudentsResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "message": { "type": "string" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Student" }
          }
        }
      },
      "StudentResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Student" }
        }
      },
      "CourseCreateResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "course": { "type": "string" }
            }
          }
        }
      },
      "CourseDeleteResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "message": { "type": "string" },
          "data": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "message": { "type": "string" },
          "data": {}
        }
      }
    }
  }
}
