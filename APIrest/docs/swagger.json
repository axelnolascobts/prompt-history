{
  "openapi": "3.0.0",
  "info": {
    "title": "Student Management API",
    "version": "1.0.0",
    "description": "A RESTful API to manage students and their courses"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/students": {
      "get": {
        "summary": "Retrieve all students",
        "tags": ["Students"],
        "responses": {
          "200": {
            "description": "List of all students",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Student"
                  }
                },
                "examples": {
                  "sample": {
                    "summary": "Example response",
                    "value": [
                      {
                        "id": "123e4567-e89b-12d3-a456-426614174000",
                        "name": "John Smith",
                        "email": "john@example.com",
                        "courses": ["Math", "Biology"]
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "Students not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Students not found"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new student",
        "tags": ["Students"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewStudent"
              },
              "example": {
                "name": "Jane Doe",
                "email": "jane@example.com",
                "courses": ["Math", "Science"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or email already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/students/{id}": {
      "get": {
        "summary": "Retrieve a student by ID",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Student found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Fully update a student by ID",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewStudent" }
            }
          }
        },
        "responses": {
          "200": { "description": "Student updated successfully" },
          "400": { "description": "Invalid input" },
          "404": { "description": "Student not found" }
        }
      },
      "patch": {
        "summary": "Partially update a student by ID",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PartialStudent" }
            }
          }
        },
        "responses": {
          "200": { "description": "Student partially updated" },
          "400": { "description": "Invalid input" },
          "404": { "description": "Student not found" }
        }
      },
      "delete": {
        "summary": "Delete a student by ID",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Student deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "deleted": { "$ref": "#/components/schemas/Student" }
                  }
                }
              }
            }
          },
          "404": { "description": "Student not found" }
        }
      }
    },
    "/students/email/{email}": {
      "get": {
        "summary": "Retrieve a student by email",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "email" }
          }
        ],
        "responses": {
          "200": { "description": "Student found" },
          "404": { "description": "Student not found" }
        }
      },
      "put": {
        "summary": "Fully update a student by email",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "email" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewStudent" }
            }
          }
        },
        "responses": {
          "200": { "description": "Student updated successfully" },
          "400": { "description": "Invalid input" },
          "404": { "description": "Student not found" }
        }
      },
      "patch": {
        "summary": "Partially update a student by email",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "email" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PartialStudent" }
            }
          }
        },
        "responses": {
          "200": { "description": "Student partially updated" },
          "400": { "description": "Invalid input" },
          "404": { "description": "Student not found" }
        }
      },
      "delete": {
        "summary": "Delete a student by email",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "email" }
          }
        ],
        "responses": {
          "200": {
            "description": "Student deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "deleted": { "$ref": "#/components/schemas/Student" }
                  }
                }
              }
            }
          },
          "404": { "description": "Student not found" }
        }
      }
    },
    "/students/name/{name}": {
      "get": {
        "summary": "Search students by partial name",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Partial or full name of the student"
          }
        ],
        "responses": {
          "200": {
            "description": "Students found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Student" }
                }
              }
            }
          },
          "404": {
            "description": "No students found with that name",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Operation not allowed by name",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "400": {
            "description": "Operations by name are forbidden",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Only allowed by email or id" }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Operation not allowed by name",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "400": {
            "description": "Operations by name are forbidden",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Only allowed by email or id" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Operation not allowed by name",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "400": {
            "description": "Operations by name are forbidden",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Only allowed by email or id" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Student": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "courses": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "NewStudent": {
        "type": "object",
        "required": ["name", "email", "courses"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "courses": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "PartialStudent": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "courses": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "error": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
