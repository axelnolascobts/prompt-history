{
  "openapi": "3.0.0",
  "info": {
    "title": "Student Management API",
    "version": "1.0.0",
    "description": "A RESTful API to manage students and their courses"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/students": {
      "get": {
        "summary": "Retrieve all students",
        "tags": ["Students"],
        "responses": {
          "200": {
            "description": "List of all students",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Student"
                  }
                },
                "examples": {
                  "sample": {
                    "summary": "Example response",
                    "value": [
                      {
                        "id": "123e4567-e89b-12d3-a456-426614174000",
                        "name": "John Smith",
                        "email": "john@example.com",
                        "courses": ["Math", "Biology"]
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "Students not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Students not found"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new student",
        "tags": ["Students"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewStudent"
              },
              "example": {
                "name": "Jane Doe",
                "email": "jane@example.com",
                "courses": ["Math", "Science"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or email already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidInput": {
                    "summary": "Input validation failed",
                    "value": {
                      "message": "Invalid input",
                      "errors": [
                        {
                          "field": "email",
                          "error": "Invalid format"
                        }
                      ]
                    }
                  },
                  "emailExists": {
                    "summary": "Email already registered",
                    "value": {
                      "message": "The email already exists"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/students/{id}": {
      "get": {
        "summary": "Retrieve a student by ID",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "UUID of the student",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Student found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                },
                "examples": {
                  "studentExample": {
                    "summary": "Student data",
                    "value": {
                      "id": "123e4567-e89b-12d3-a456-426614174000",
                      "name": "John Smith",
                      "email": "john@example.com",
                      "courses": ["Math", "Biology"]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Student not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Fully update a student",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "UUID of the student to update",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewStudent"
              },
              "example": {
                "name": "Jane Smith",
                "email": "jane@example.com",
                "courses": ["Math", "Science"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Student updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or no change in data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingFields": {
                    "summary": "Missing required fields",
                    "value": {
                      "message": "name and email required"
                    }
                  },
                  "noChange": {
                    "summary": "No data was changed",
                    "value": {
                      "message": "All fields must differ from current values"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Student not found"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Partially update a student",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "UUID of the student to partially update",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartialStudent"
              },
              "example": {
                "name": "Jane Partial",
                "courses": ["History", "Art"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Student partially updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Invalid input"
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Student not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a student by ID",
        "tags": ["Students"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "UUID of the student to delete",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Student deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "deleted": { "$ref": "#/components/schemas/Student" }
                  }
                },
                "example": {
                  "message": "Student deleted",
                  "deleted": {
                    "id": "123e4567-e89b-12d3-a456-426614174000",
                    "name": "John Smith",
                    "email": "john@example.com",
                    "courses": ["Math", "Biology"]
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Student not found"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Student": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "John Smith",
            "description": "Full name of the student; only letters, spaces, apostrophes, periods, and hyphens allowed"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com",
            "description": "Valid email address"
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["Math", "Biology"],
            "description": "List of course names; no duplicates allowed; only letters, numbers, and spaces"
          }
        }
      },
      "NewStudent": {
        "type": "object",
        "required": ["name", "email", "courses"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the student; required; only letters, spaces, apostrophes, periods, and hyphens allowed"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Valid email address; required"
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Course name; must be non-empty string; only letters, numbers, and spaces"
            },
            "description": "Array of course names; no duplicates allowed; required"
          }
        }
      },
      "PartialStudent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the student; only letters, spaces, apostrophes, periods, and hyphens allowed"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Valid email address"
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Course name; must be non-empty string; only letters, numbers, and spaces"
            },
            "description": "Array of course names; no duplicates allowed"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Description of the error"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "error": { "type": "string" }
              }
            },
            "description": "Optional list of validation errors"
          }
        }
      }
    }
  }
}
