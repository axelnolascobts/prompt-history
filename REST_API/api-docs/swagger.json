{
  "openapi": "3.0.0",
  "info": {
    "title": "REST API PRACTICE",
    "version": "1.0.0",
    "description": "REST API to manage students"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/students": {
      "get": {
        "summary": "Get all students",
        "responses": {
          "200": {
            "description": "List of all students",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Student" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new student",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StudentInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Student" }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid data sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "examples": {
                  "invalidFormat": {
                    "summary": "Invalid input format",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Invalid input format" }
                      ]
                    }
                  },
                  "studentExists": {
                    "summary": "If email alredy in use",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "This student already exists, use other data" }
                      ]
                    }
                  },
                  "emptyFild": {
                    "summary": "Empy name",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Name is required and obligatory data, please fill it" }
                      ]
                    }
                  },
                  "repeatedCourses": {
                    "summary": "Repeated Courses",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Check the courses, there cannot be repeated courses or in this case empty courses" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Failed to save student",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "example": {
                  "status": 500,
                  "data": [
                    { "message": "Failed to save student" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/students/search": {
      "get": {
        "summary": "Search for a student by id, email or name",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "email",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "name",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Student found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "oneOf": [
                        { "$ref": "#/components/schemas/Student" },
                        {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Student" }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "example": {
                  "status": 404,
                  "data": [
                    { "message": "Student not found or not exist" }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Fully update a student by id or email",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "email",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StudentInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Student updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Student" }
              }
            }
          },
          "400": {
            "description": "Invalid data sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "examples": {
                  "invalidFormat": {
                    "summary": "Invalid input format",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Invalid input format" }
                      ]
                    }
                  },
                  "studentExists": {
                    "summary": "If email alredy in use",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "This student already exists, use other data" }
                      ]
                    }
                  },
                  "emptyFild": {
                    "summary": "Empy name",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Name is required and obligatory data, please fill it" }
                      ]
                    }
                  },
                  "repeatedCourses": {
                    "summary": "Repeated Courses",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Check the courses, there cannot be repeated courses or in this case empty courses" }
                      ]
                    }
                  },
                  "serachParamIncorrect": {
                    "summary": "User try to find a student with his/her name",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "To edit a student, search by ID or email, please" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "example": {
                  "status": 404,
                  "data": [
                    { "message": "Student not found or not exist" }
                  ]
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Partially update a student by id or email",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "email",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StudentPartialInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Student updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Student" }
              }
            }
          },
          "400": {
            "description": "Invalid data sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "examples": {
                  "invalidFormat": {
                    "summary": "Invalid input format",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Invalid input format" }
                      ]
                    }
                  },
                  "studentExists": {
                    "summary": "If email alredy in use",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "This student already exists, use other data" }
                      ]
                    }
                  },
                  "emptyFild": {
                    "summary": "Empy name",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Name is required and obligatory data, please fill it" }
                      ]
                    }
                  },
                  "repeatedCourses": {
                    "summary": "Repeated Courses",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Check the courses, there cannot be repeated courses or in this case empty courses" }
                      ]
                    }
                  },
                  "serachParamIncorrect": {
                    "summary": "User try to find a student with his/her name",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "To edit a student, search by ID or email, please" }
                      ]
                    }
                  },
                  "everythingAreUndefined": {
                    "summary": "Every data are undefined",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "The entire user cannot be updated because some data did not change. Please change something" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "example": {
                  "status": 404,
                  "data": [
                    { "message": "Student not found or not exist" }
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a student by id or email",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "email",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": {
            "description": "Student deleted successfully"
          },
          "400": {
            "description": "Incorrect search parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "example": {
                  "status": 400,
                  "data": [
                    { "message": "To delete a student, search by ID or email, please" }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "example": {
                  "status": 404,
                  "data": [
                    { "message": "Student not found or not exist" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/students/{id}/courses": {
      "get": {
        "summary": "Get courses of a student by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of courses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "example": {
                  "status": 404,
                  "data": [
                    { "message": "Student not found or not exist" }
                  ]
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update the courses of a student by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courses": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["courses"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Courses updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Student" }
              }
            }
          },
          "400": {
            "description": "Invalid data format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "examples": {
                  "invalidFormat": {
                    "summary": "Invalid input format",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "Invalid input format" }
                      ]
                    }
                  },
                  "studentExists": {
                    "summary": "Repeated courses",
                    "value": {
                      "status": 400,
                      "data": [
                        { "message": "TCheck the courses, there cannot be repeated or empty courses" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ErrorMessage" }
                    }
                  }
                },
                "example": {
                  "status": 404,
                  "data": [
                    { "message": "Student not found or not exist" }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Student": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "courses": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "name", "email", "courses"]
      },
      "StudentInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "courses": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["name", "email"]
      },
      "StudentPartialInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "courses": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "required": ["message"]
      }
    }
  }
}
